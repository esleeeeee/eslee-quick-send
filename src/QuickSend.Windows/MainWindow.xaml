<Window
    x:Class="Eslee.QuickSend.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="eslee QuickSend">

    <Grid
        x:Name="RootDropSurface"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        AllowDrop="True"
        DragEnter="RootDropSurface_DragEnter"
        DragOver="RootDropSurface_DragOver"
        DragLeave="RootDropSurface_DragLeave"
        Drop="RootDropSurface_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="28,20" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrandBrush}">
                        <FontIcon Glyph="&#xE898;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="eslee QuickSend" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="연결이 끊겨도 자동으로 이어서 전송합니다" Opacity="0.68" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Click="Settings_Click" ToolTipService.ToolTip="설정" AutomationProperties.Name="설정">
                    <FontIcon Glyph="&#xE713;" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <Grid Padding="28" MaxWidth="1120" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="20">
                    <Border Padding="22" CornerRadius="16" Background="{StaticResource SubtleCardBrush}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="현재 전송" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock x:Name="StatusText" Text="전송할 파일을 선택하세요" Opacity="0.7" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,5" CornerRadius="12" Background="{StaticResource BrandBrush}">
                                    <TextBlock x:Name="AutoRecoveryText" Text="자동 이어받기 켜짐" Foreground="White" FontSize="12" />
                                </Border>
                            </Grid>

                            <StackPanel x:Name="TransferMetricsPanel" Spacing="12" Visibility="Collapsed">
                                <TextBlock x:Name="CurrentFileText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <ProgressBar x:Name="JobProgress" Height="8" Minimum="0" Maximum="100" Value="0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TransferredText" Opacity="0.75" />
                                    <TextBlock x:Name="SpeedText" Grid.Column="1" FontWeight="SemiBold" />
                                </Grid>
                                <TextBlock x:Name="EtaText" Opacity="0.65" FontSize="12" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="SelectButton" Content="파일 선택" Style="{StaticResource AccentButtonStyle}" Click="Select_Click" IsEnabled="False" />
                                <Button x:Name="SelectFolderButton" Content="폴더 선택" Click="SelectFolder_Click" IsEnabled="False" />
                                <Button x:Name="PauseButton" Content="일시정지" Click="Pause_Click" IsEnabled="False" />
                                <Button x:Name="CancelButton" Content="취소" Click="Cancel_Click" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="전송 기록" FontSize="18" FontWeight="SemiBold" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button Content="기록 정리" Click="ClearHistory_Click" />
                                <Button Content="새로 고침" Click="Refresh_Click" />
                            </StackPanel>
                        </Grid>
                        <ListView x:Name="HistoryList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE930;" Foreground="{StaticResource BrandBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Opacity="0.62" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StateText}" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Location}" />
                                        <Button
                                            Grid.Column="3"
                                            Tag="{Binding FileId}"
                                            IsEnabled="{Binding CanDelete}"
                                            Click="DeleteHistory_Click"
                                            ToolTipService.ToolTip="이 전송 기록만 삭제"
                                            AutomationProperties.Name="전송 기록 삭제">
                                            <FontIcon Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="주변 기기" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="같은 네트워크의 QuickSend 기기를 자동으로 찾습니다." TextWrapping="Wrap" Opacity="0.65" FontSize="12" />
                        <ListView x:Name="DeviceList" SelectionMode="Single" SelectionChanged="DeviceList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8EA;" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusText}" Opacity="0.65" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="기기 다시 찾기" Click="Discover_Click" />
                            <Button
                                x:Name="PeerConnectionButton"
                                Content="연결 끊기"
                                Click="PeerConnection_Click"
                                IsEnabled="False"
                                ToolTipService.ToolTip="선택한 기기와의 현재 연결만 끊습니다. 신뢰 기기 등록은 유지됩니다." />
                        </StackPanel>
                        <TextBlock
                            x:Name="PeerConnectionHint"
                            Text=""
                            TextWrapping="Wrap"
                            Opacity="0.65"
                            FontSize="12" />
                    </StackPanel>

                    <Border Padding="16" CornerRadius="12" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="이 PC" FontWeight="SemiBold" />
                            <TextBlock x:Name="DeviceNameText" Text="초기화 중..." TextWrapping="Wrap" />
                            <Button Content="기기 이름 변경" Click="RenameDevice_Click" />
                            <TextBlock x:Name="ReceiveFolderText" Text="수신 폴더 확인 중..." TextWrapping="Wrap" Opacity="0.65" FontSize="12" />
                            <TextBlock x:Name="VersionText" TextWrapping="Wrap" Opacity="0.65" FontSize="12" />
                            <TextBlock
                                x:Name="UpdateStatusText"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{StaticResource BrandBrush}"
                                Visibility="Collapsed" />
                            <TextBlock Text="파일은 인터넷을 거치지 않습니다" Foreground="{StaticResource BrandBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="DropOverlay"
            Grid.RowSpan="2"
            Canvas.ZIndex="100"
            Margin="18"
            Padding="36"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            Background="{StaticResource SubtleCardBrush}"
            BorderBrush="{StaticResource BrandBrush}"
            BorderThickness="3"
            CornerRadius="20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <FontIcon Glyph="&#xE898;" FontSize="48" Foreground="{StaticResource BrandBrush}" />
                <TextBlock Text="파일 및 폴더를 놓아 전송" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="DropOverlayCaption" Text="선택한 기기로 안전하게 전송합니다" Opacity="0.72" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
