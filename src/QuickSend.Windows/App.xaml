<Application
    x:Class="Eslee.QuickSend.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="BrandColor">#176B5B</Color>
            <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
            <SolidColorBrush x:Key="SubtleCardBrush" Color="#0D176B5B" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#30000000" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
