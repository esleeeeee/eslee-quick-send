<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. The foreground keeps the artwork inside the 72dp safe zone so
  neither the wordmark nor the arrows are clipped by a circular or squircle mask, and the
  background is the QuickSend brand green taken from the master artwork.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
